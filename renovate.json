{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:gomodIndirectSecurityUpdates",
    ":semanticCommitTypeAll(chore)"
  ],
  "enabledManagers": [
    "maven",
    "gomod",
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "jackson.bundle.version.annotations pins the jackson-annotations OSGi bundle in the Karaf feature. Jackson 3 keeps using the 2.x jackson-annotations (major.minor only), decoupled from jackson.version, and it is not a dependency declaration, so the maven manager never sees it. Tracking it here keeps it in the same grouped jackson PR",
      "customType": "regex",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": ["<jackson\\.bundle\\.version\\.annotations>(?<currentValue>.*?)</jackson\\.bundle\\.version\\.annotations>"],
      "depNameTemplate": "com.fasterxml.jackson.core:jackson-annotations",
      "datasourceTemplate": "maven"
    }
  ],
  "ignorePaths": [
    "**/src/it/**"
  ],
  "description": "commitMessageExtra is the upstream default with 'from {{{currentValue}}}' prepended: the version being left behind is what tells a reviewer the blast radius of the bump. Renovate drops commitMessageExtra on grouped branches, so this only shows up on single-dependency PRs; grouped ones keep the from/to in the PR body table",
  "commitMessageExtra": "from {{{currentValue}}} to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 10,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "reviewers": ["oscerd", "rohanKanojia", "manusa"]
    },
    {
      "description": "httpclient-vertx (4.x) and httpclient-vertx-5 (5.x) each stay on their own major",
      "matchPackageNames": ["io.vertx:**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Jetty 13 requires Java 25; we still target Java 17",
      "matchPackageNames": ["org.eclipse.jetty**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "swagger-request-validator 3.x requires Java 21; we still target Java 17. 3.x also renamed the artifact to openapi-request-validator-core, which arrives as a replacement rather than a major, so both update types are disabled",
      "matchPackageNames": ["com.atlassian.oai:**"],
      "matchUpdateTypes": ["major", "replacement"],
      "enabled": false
    },
    {
      "description": "org.gradle:gradle-all is not published to Maven Central. gradle-api-maven-plugin synthesizes it locally from the Gradle distribution, so the lookup can only ever fail. gradle-api.version is a compatibility floor for the Gradle plugin and is bumped deliberately",
      "matchPackageNames": ["org.gradle:gradle-all"],
      "enabled": false
    },
    {
      "matchPackageNames": ["org.bouncycastle:**"],
      "groupName": "bouncycastle"
    },
    {
      "matchPackageNames": ["com.fasterxml.jackson**", "tools.jackson**"],
      "groupName": "jackson"
    },
    {
      "matchPackageNames": ["org.eclipse.jetty**"],
      "groupName": "jetty"
    },
    {
      "matchPackageNames": ["org.keycloak:**", "org.jboss.logging:**"],
      "groupName": "keycloak"
    },
    {
      "matchPackageNames": ["com.squareup.okhttp3:**"],
      "groupName": "okhttp"
    },
    {
      "matchPackageNames": ["org.apache.maven.plugins:**", "org.apache.maven:**", "org.codehaus.mojo:**"],
      "groupName": "maven-plugins"
    },
    {
      "matchPackageNames": [
        "org.junit**",
        "org.mockito:**",
        "org.assertj:**",
        "org.awaitility:**",
        "com.approvaltests:**",
        "org.spockframework:**"
      ],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["org.apache.logging.log4j:**", "org.slf4j:**", "ch.qos.logback**"],
      "groupName": "logging"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "replace directives in go.mod are deliberate pins: keep them visible on the dashboard but don't open PRs unasked",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["replace"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Pseudo-version pins: the current version is never in the release list, so no release age can be established and a digest update would be withheld forever under minimumReleaseAge",
      "matchManagers": ["gomod"],
      "matchCurrentValue": "/^v0\\.0\\.0-/",
      "minimumReleaseAge": null
    },
    {
      "description": "Nested modules without tags of their own: the lookup falls back to the parent repo's tags, which don't contain the package. Only track pseudo-versions (digests)",
      "matchPackageNames": [
        "github.com/ovn-org/ovn-kubernetes/go-controller",
        "github.com/chaos-mesh/chaos-mesh/api",
        "github.com/openshift/hive/apis"
      ],
      "allowedVersions": "/^v0\\.0\\.0-/"
    },
    {
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "kubernetes"
    },
    {
      "description": "kube-openapi's main branch can move ahead of k8s.io/apimachinery (e.g. to structured-merge-diff/v7) and break the generator build. It gets its own monthly PR, which stays red until k8s.io catches up, instead of blocking the kubernetes group. The group's go mod tidy still raises it whenever a k8s.io release requires a newer one",
      "matchPackageNames": ["k8s.io/kube-openapi"],
      "groupName": "kube-openapi",
      "schedule": ["* 0-3 1 * *"]
    },
    {
      "matchPackageNames": ["github.com/openshift/**"],
      "groupName": "openshift"
    },
    {
      "matchPackageNames": ["knative.dev/**"],
      "groupName": "knative"
    },
    {
      "matchPackageNames": ["go.opentelemetry.io/**"],
      "groupName": "opentelemetry"
    },
    {
      "matchPackageNames": ["golang.org/x/**"],
      "groupName": "golang-x"
    },
    {
      "matchPackageNames": ["google.golang.org/**", "github.com/google/**"],
      "groupName": "google-apis"
    },
    {
      "matchPackageNames": ["github.com/go-openapi/**"],
      "groupName": "go-openapi"
    },
    {
      "matchPackageNames": ["github.com/operator-framework/**"],
      "groupName": "operator-framework"
    },
    {
      "matchPackageNames": ["github.com/tektoncd/**"],
      "groupName": "tektoncd"
    },
    {
      "matchPackageNames": ["github.com/metal3-io/**"],
      "groupName": "metal3-io"
    },
    {
      "matchPackageNames": ["github.com/stolostron/**"],
      "groupName": "stolostron"
    },
    {
      "matchPackageNames": ["open-cluster-management.io/**"],
      "groupName": "open-cluster-management"
    },
    {
      "matchPackageNames": ["github.com/prometheus/**", "github.com/prometheus-operator/**"],
      "groupName": "prometheus"
    },
    {
      "matchPackageNames": ["github.com/cloudevents/**"],
      "groupName": "cloudevents"
    },
    {
      "matchPackageNames": ["github.com/Azure/**"],
      "groupName": "azure"
    },
    {
      "matchPackageNames": ["go.uber.org/**"],
      "groupName": "go-uber"
    }
  ]
}
